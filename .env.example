# Server & Environment Configuration
NODE_ENV=development
PORT=3000

# Security Secrets
JWT_SIGNING_KEY=your-jwt-signing-key-here-32bytes
JWT_ACCESS_TTL_SECONDS=900
IP_HASH_SECRET=your-dedicated-ip-hash-secret-minimum-32-chars-long

# Database & Storage
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mogvkwp.mongodb.net/ratri?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# Client CORS & Origins (comma-separated origins or wildcards allowed to make requests)
CLIENT_ORIGIN=https://your-app.vercel.app,*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Public site configuration
SITE_URL=https://ratri-silk.vercel.app
